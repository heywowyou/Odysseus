# Copy this file to deploy/.deploy.local.env (gitignored, never commit the
# real values) and fill in your VPS details. Used by odysseus-deploy.sh.

# user@host or user@ip for the production VPS's deploy user.
ODYSSEUS_DEPLOY_HOST=deploy@your.vps.ip

# SSH private key authorized as that user. Default: your normal default
# identity (~/.ssh/id_ed25519).
# ODYSSEUS_DEPLOY_SSH_KEY=$HOME/.ssh/id_ed25519

# Where the repo is rsynced to on the server. Default matches the runbook.
# ODYSSEUS_DEPLOY_REMOTE_PATH=/srv/odysseus

# Where the Hostinger Docker Manager panel's own docker-compose.yml lives on
# the server (a separate copy from this repo's deploy/compose.yaml, owned by
# the panel). Default matches the current production box.
# ODYSSEUS_DEPLOY_COMPOSE_DIR=/docker/odysseus

# Must match the panel's compose `name:` field. Never set this to "deploy" -
# that collides with the old release.sh project name.
# ODYSSEUS_DEPLOY_COMPOSE_PROJECT=odysseus
