# Minimal reverse proxy: automatic HTTPS with a managed certificate for the
# dashboard host, proxied to the app service over the compose network.
#
# Caddy passes the client's Host header through unchanged and sets
# X-Forwarded-For / X-Forwarded-Proto by default. The app depends on both:
# its CSRF check compares the request's Origin against Host, the session
# cookie's Secure flag is set from X-Forwarded-Proto: https, and so is the
# Strict-Transport-Security header (packages/interface/src/security-headers.ts).
#
# Production serves this one HTTPS site and nothing else. The plain-HTTP
# localhost site the local smoke needs lives in Caddyfile.smoke, mounted only
# by compose.smoke.yaml, so no plaintext listener that proxies to the app
# ships to the server.
#
# encode compresses what the browser accepts (issue #512): the dashboard's
# JSON polls and its script bundle compress several times over. Keep it in
# step with Caddyfile.smoke.

app.odysseusaudit.com {
	encode zstd gzip
	reverse_proxy app:4600
}
