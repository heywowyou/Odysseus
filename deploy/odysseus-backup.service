[Unit]
Description=Odysseus nightly artifacts backup (tar + rclone to Scaleway)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as the deploy user, which is in the docker group (to stream the tar
# out of the app container) and owns the rclone config for the scaleway
# remote.
User=deploy
Group=deploy
# Optional: ODYSSEUS_BACKUP_REMOTE, the private backup bucket's rclone remote
# (runbook section 8). Missing file = the legacy previews-bucket location.
EnvironmentFile=-/srv/odysseus/.backup.env
ExecStart=/srv/odysseus/deploy/backup-artifacts.sh
