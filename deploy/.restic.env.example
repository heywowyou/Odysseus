# Copy to /srv/odysseus/.restic.env (0600). This file is passed only to
# the restic container, never the Odysseus app.
#
# Example Scaleway S3 repository:
# RESTIC_REPOSITORY=s3:https://s3.fr-par.scw.cloud/odysseus-restic
RESTIC_REPOSITORY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for S3-compatible providers:
# AWS_DEFAULT_REGION=fr-par
