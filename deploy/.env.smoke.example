# Local smoke env for deploy/compose.yaml only (deploy/runbook.md section
# 10). Copy it next to it as ../.env.smoke (repo root) and delete it after
# the smoke. Nothing in this file is safe for a real deployment; when both
# exist, values here override the developer .env for the smoke containers.

# Points at the repo's own docker-compose.yml test Mongo on host port 27018,
# reached through host.docker.internal (compose adds the extra_hosts mapping
# during the smoke; the runbook shows exactly when).
MONGODB_URI=mongodb://host.docker.internal:27018/odysseus_smoke

# Stub hash protecting the smoke run only. Generated with:
#   printf '%s' 'odysseus-smoke-only' | node scripts/hash-dashboard-password.mjs
# The matching plaintext is odysseus-smoke-only. Local smoke only: never
# reuse this value where a real person's password would be acceptable.
ODYSSEUS_DASHBOARD_PASSWORD_HASH=ef705b58759fb336e822ce29bfed9090:6bb2b04a41c6e49d22f7f85a5125f837681465f85a3b7150c1d38084e0ea9f11ed2f3c74f26fe676a7f3edf59b353260dbc571a535aefcd300c73b81d4a27fc8

# Unused by the smoke: no preview publication happens in it. Present and
# visibly fake so a leaked smoke env is never mistaken for real credentials.
ODYSSEUS_PREVIEW_BUCKET_NAME=smoke-unused-bucket
ODYSSEUS_PREVIEW_BUCKET_ENDPOINT=https://s3.fr-par.scw.cloud
ODYSSEUS_PREVIEW_BUCKET_REGION=fr-par
ODYSSEUS_PREVIEW_BUCKET_ACCESS_KEY_ID=SMOKE-UNUSED-ACCESS-KEY
ODYSSEUS_PREVIEW_BUCKET_SECRET_KEY=smoke-unused-secret-key
ODYSSEUS_PREVIEW_PUBLIC_BASE_URL=https://www.odysseusaudit.com

# ODYSSEUS_ARTIFACTS_ROOT is deliberately absent: deploy/compose.yaml sets
# it to /data/artifacts, and that compose default is part of what the smoke
# exercises.
