.env
node_modules/
dist/
/artifacts/
/packages/*/artifacts/
/data/
.claude/settings.local.json
reports/
*.pdf
.DS_Store
*.log
coverage/
.vitest/
*.tsbuildinfo
.playwright-mcp/

# pnpm's local content-addressable package cache. Appears when pnpm falls
# back to a project-local store dir instead of the global one; a cache, not
# repo content, and regenerates on install.
/.pnpm-store/

# ZCode session scratch: browser driver scripts and screenshots taken while
# exercising the dashboard. Agent tooling, never repo content; it also holds
# client site captures that must not be committed.
/.zcode/

# The runbook's local smoke (section 10) copies its stub-secret env to the
# repo root; it must never be committed.
/.env.smoke

# odysseus-deploy.sh's real VPS host/key/compose settings for this machine.
# Copy deploy/.deploy.local.env.example to fill this in; never commit it.
/deploy/.deploy.local.env

# Crash-recovery session log. Ephemeral by design: written continuously from
# docs/agents/session-template.md, folded into canonical docs, and retained
# while uncommitted work still needs provenance.
/docs/session/current-session.md

# Impeccable live-mode output is local session scratch. The one committed
# config keeps the PDF workbench discoverable across agent sessions.
/.impeccable/live/*
!/.impeccable/live/config.json

# Issue #261's CI Semgrep step writes its SARIF report here; only the CI
# workflow's own artifact upload needs it, never the repo.
/semgrep-odysseus.sarif.json
