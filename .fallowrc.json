{
  "entry": [
    "scripts/*.mjs",
    "packages/interface/src/dashboard/index.html",
    "packages/interface/src/dashboard/main.tsx",
    "packages/llm/src/lint-stored-analyses.ts",
    "packages/llm/src/measure-reasoning-effort.ts",
    "packages/report/src/styles/*.css",
    "packages/scanner/src/lighthouse-worker.ts"
  ],
  "ignorePatterns": [
    "fixtures/hotel-demo/**",
    "fixtures/prospecting/**",
    "fixtures/test-audits/**",
    "docs/report/design/**"
  ],
  // Kept exported on purpose so page-audit-profile.test.ts can pin the same
  // selector vocabulary as extractRawPageAuditFacts's inlined copy (an
  // evaluate closure can't reference module scope). The test currently
  // hardcodes the literal instead of importing this - test drift, not dead
  // code; noted in trade-offs.md#80's 2026-09-11 triage for whoever next
  // touches that test.
  //
  // CURRENT_OUTREACH_PROMPT_VERSION is a genuinely independent version knob
  // in each of create-follow-up-draft.ts and create-outreach-draft.ts:
  // first-touch and follow-up prompts can be revised on separate schedules.
  // index.ts re-exports both, aliasing the follow-up one as
  // FOLLOW_UP_PROMPT_VERSION to disambiguate. Deliberate duplication, not
  // accidental.
  "ignoreExports": [
    {
      "file": "packages/scanner/src/page-audit-profile.ts",
      "exports": ["SITE_WIDE_CHROME_SELECTOR"]
    },
    {
      "file": "packages/interface/src/outreach/create-follow-up-draft.ts",
      "exports": ["CURRENT_OUTREACH_PROMPT_VERSION"]
    },
    {
      "file": "packages/interface/src/outreach/create-outreach-draft.ts",
      "exports": ["CURRENT_OUTREACH_PROMPT_VERSION"]
    }
  ],
  // Both are pnpm-workspace.yaml CVE-fix pins on transitive dependencies
  // (nth-check ReDoS, validator ReDoS), the same pattern as the documented
  // lodash.pick override right above them in that file. fallow flags them
  // because nothing in the workspace depends on these packages by that
  // exact version range directly - that is the point of a transitive
  // override.
  "ignoreDependencyOverrides": [
    { "package": "nth-check", "source": "pnpm-workspace.yaml" },
    { "package": "validator", "source": "pnpm-workspace.yaml" }
  ],
  "boundaries": {
    "zones": [
      { "name": "core", "patterns": ["packages/core/src/**"] },
      { "name": "scanner", "patterns": ["packages/scanner/src/**"] },
      { "name": "store", "patterns": ["packages/store/src/**"] },
      { "name": "llm", "patterns": ["packages/llm/src/**"] },
      { "name": "report", "patterns": ["packages/report/src/**"] },
      { "name": "interface", "patterns": ["packages/interface/src/**"] },
      { "name": "cli", "patterns": ["packages/cli/src/**"] },
      { "name": "site", "patterns": ["packages/site/app/**", "packages/site/lib/**"] }
    ],
    "rules": [
      { "from": "core", "allow": [] },
      { "from": "scanner", "allow": ["core"] },
      { "from": "store", "allow": ["core"] },
      { "from": "llm", "allow": ["core"] },
      { "from": "report", "allow": ["core", "llm", "scanner"] },
      { "from": "interface", "allow": ["core", "llm", "report", "scanner", "store"] },
      { "from": "cli", "allow": ["core", "llm", "report", "scanner", "store", "interface"] },
      { "from": "site", "allow": [] }
    ],
    "coverage": { "requireAllFiles": false }
  }
}
