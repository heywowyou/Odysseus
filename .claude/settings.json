{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(/.env)",
      "Bash(node scripts/fetch-client-report.mjs *)",
      "Bash(node scripts/upload-finalized-report.mjs *)",
      "Bash(pnpm run report:finalize-render *)",
      "Bash(deploy/odysseus-deploy.sh)",
      "Bash(deploy/odysseus-deploy.sh *)",
      "Bash(pdfinfo *)",
      "Bash(pdftotext *)",
      "Bash(pdftoppm *)",
      "Bash(sha256sum *)"
    ],
    "deny": [
      "Edit(/.env)"
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  }
}
