OPENAI_API_KEY=
# Optional. Leave unset for OpenAI's standard endpoint. Organizations with EU
# data residency enabled can opt into their configured regional endpoint.
# OPENAI_BASE_URL=https://eu.api.openai.com/v1
MONGODB_URI=mongodb://localhost:27017/odysseus
# Issue #38: the database to use when MONGODB_URI names none in its path
# (an Atlas URI usually does not). Set a database THIS machine owns, never
# the production dashboard's: that separation is what stops a scan run
# locally from surfacing as a server record with no artifacts behind it.
# A database named in the MONGODB_URI path wins over this, so the test
# URIs below are unaffected. Unset, every command that persists refuses
# to connect instead of falling into a default database. The production
# value is pinned in deploy/compose.yaml, not here.
MONGODB_DB_NAME=
# Used only by packages/store's integration tests, never by the CLI.
# Matches docker-compose.yml's mongo-test service (offset port so it never
# collides with a developer's own local Mongo on 27017).
MONGODB_TEST_URI=mongodb://localhost:27018/odysseus_test
# No page cap by default since 2026-08-24: a silent cap once under-reported a
# real audit by more than a third, so the cap is strictly opt-in now. Set a
# positive whole number only when one specific audit genuinely needs it.
# MAX_PAGES=
# MAX_CRAWL_DEPTH=
CRAWL_DELAY_MS=333
PAGE_TIMEOUT_MS=30000
LIGHTHOUSE_TIMEOUT_MS=120000
# Blank = <workspace root>/artifacts
ODYSSEUS_ARTIFACTS_ROOT=

# Render diff/axe/Lighthouse lanes run per page (trade-off #10 in
# docs/decisions/trade-offs.md). Blank, zero, or negative all fall back to 3.
SCAN_CONCURRENCY=3
# packages/interface's job queue: how many audits run at once. Blank, zero, or
# negative fall back to 1 (sequential). Raise only with the RAM headroom to
# match: each concurrent audit is its own Chromium plus Lighthouse.
QUEUE_CONCURRENCY=1

# Milestone 8.6. Chrome UX Report (CrUX) API key - generate one at
# https://goo.gle/crux-api-key. Blank = the CrUX field-data check is
# skipped entirely for every audit, not attempted and failed.
CRUX_API_KEY=

# Read-only Atlas user, used only by the mongodb-readonly MCP server for
# ad hoc inspection during development, never by the CLI or app code.
MDB_MCP_CONNECTION_STRING=

# Milestone 9c plan 009. The private bucket outreach previews are published to,
# and the base URL the link in an email points at. The three credentials have no
# default and throw when unset, so a publish command cannot look configured,
# sign with an empty key, and fail at the provider with a message about
# credentials rather than about this machine's .env.
#
# Set the same bucket, endpoint, region and credentials on the site deployment
# without the ODYSSEUS_ prefix (PREVIEW_BUCKET_NAME and so on): the public site
# reads its own environment and imports nothing from this workspace.
ODYSSEUS_PREVIEW_BUCKET_NAME=
ODYSSEUS_PREVIEW_BUCKET_ENDPOINT=https://s3.fr-par.scw.cloud
ODYSSEUS_PREVIEW_BUCKET_REGION=fr-par
ODYSSEUS_PREVIEW_BUCKET_ACCESS_KEY_ID=
ODYSSEUS_PREVIEW_BUCKET_SECRET_KEY=
# www, because the apex redirects and a redirect would carry a live token
# through a second host's request log.
ODYSSEUS_PREVIEW_PUBLIC_BASE_URL=https://www.odysseusaudit.com

# Plan 071: the separately permissioned bucket for the approved permanent
# synthetic reference report. The private publisher needs read/write access to
# this namespace; the public site is configured with equivalent
# REFERENCE_AUDIT_BUCKET_* values and read-only access.
ODYSSEUS_REFERENCE_AUDIT_BUCKET_ENDPOINT=https://s3.fr-par.scw.cloud
ODYSSEUS_REFERENCE_AUDIT_BUCKET_REGION=fr-par
ODYSSEUS_REFERENCE_AUDIT_BUCKET_NAME=
ODYSSEUS_REFERENCE_AUDIT_BUCKET_ACCESS_KEY_ID=
ODYSSEUS_REFERENCE_AUDIT_BUCKET_SECRET_ACCESS_KEY=
ODYSSEUS_REFERENCE_AUDIT_PUBLIC_BASE_URL=https://www.odysseusaudit.com

# Optional Plan 071 reference-link receipts. Leave the block empty to keep
# the public link canonical and untracked; attribution is fail-open and uses
# a separate receipt namespace from the published PDF.
ODYSSEUS_REFERENCE_AUDIT_RECEIPT_BUCKET_ENDPOINT=https://s3.fr-par.scw.cloud
ODYSSEUS_REFERENCE_AUDIT_RECEIPT_BUCKET_REGION=fr-par
ODYSSEUS_REFERENCE_AUDIT_RECEIPT_BUCKET_NAME=
ODYSSEUS_REFERENCE_AUDIT_RECEIPT_BUCKET_ACCESS_KEY_ID=
ODYSSEUS_REFERENCE_AUDIT_RECEIPT_BUCKET_SECRET_KEY=

# Milestone 9c plan 011: the mailbox that outreach drafts are created in.
# A Google Workspace account on the sending domain, with an OAuth client of
# user type Internal - that user type is what avoids refresh tokens expiring
# after seven days. Scopes: gmail.compose (drafts) and gmail.metadata (thread
# reads). Note that no Gmail scope can grant draft creation without also
# granting send: the guarantee that this tool cannot send is a property of the
# adapter's shape, not of the permission. Leave these empty and every drafting
# command refuses rather than falling back to anything.
ODYSSEUS_MAILBOX_CLIENT_ID=
ODYSSEUS_MAILBOX_CLIENT_SECRET=
ODYSSEUS_MAILBOX_REFRESH_TOKEN=
# The address drafts are created as. A caller cannot override it, so a draft
# can never be built with a sender the operator did not configure here.
# Interim: contact@odysseusaudit.com. The intended sending address is
# contact@odysseusaudit.fr, and it must be repointed there before the first
# send to a real prospect, not before the first draft. Reasoning and the full
# switch checklist: docs/rules/outreach-rules.md section 10, item 1.
ODYSSEUS_MAILBOX_SENDER_ADDRESS=

# Plan 016: the operator dashboard's password, as a scrypt salt:hash string.
# Generate it with `node scripts/hash-dashboard-password.mjs` (the password
# is read from stdin so it never lands in shell history or the process list)
# and paste the printed line here. Blank = no auth on the dashboard, which
# the server then permits only while it binds to loopback.
ODYSSEUS_DASHBOARD_PASSWORD_HASH=

# packages/interface's HTTP server. The dashboard binds to loopback unless a
# password hash is set above. `odysseus serve --port` overrides the port.
# ODYSSEUS_INTERFACE_HOST=127.0.0.1
# ODYSSEUS_INTERFACE_PORT=4600
# pino log level for the interface server and job queue.
# LOG_LEVEL=info

# Optional metadata-only LLM telemetry. All three must be set together.
# Prompts, model outputs, findings, URLs and report prose are never exported.
# EU Langfuse Cloud base URL: https://cloud.langfuse.com
# LANGFUSE_BASE_URL=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Artifact bucket sync. All five must be set for sync to run; with any one
# blank, sync is skipped and artifacts stay on local disk only.
# ODYSSEUS_ARTIFACTS_BUCKET_ENDPOINT=
# ODYSSEUS_ARTIFACTS_BUCKET_REGION=
# ODYSSEUS_ARTIFACTS_BUCKET_NAME=
# ODYSSEUS_ARTIFACTS_BUCKET_ACCESS_KEY_ID=
# ODYSSEUS_ARTIFACTS_BUCKET_SECRET_ACCESS_KEY=

# Prospecting source data: operator-downloaded files under the gitignored
# data/ directory (README, "Prospecting source data"). Relative paths resolve
# against the workspace root. Blank = the defaults shown.
# ODYSSEUS_ATOUT_FRANCE_FILE_PATH=data/atout-france/hebergements_classes.csv
# ODYSSEUS_SIRENE_STOCK_PATH=data/sirene/stock-unite-legale.csv
# ODYSSEUS_AFNIC_FILE_PATH=data/afnic/fichier-a.csv
# Rows per prospecting batch. Blank, zero, or negative fall back to 2000.
# ODYSSEUS_PROSPECT_BATCH_SIZE=2000
