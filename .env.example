MISTRAL_API_KEY=
MONGODB_URI=mongodb://localhost:27017/odysseus
# Used only by packages/store's integration tests, never by the CLI.
# Matches docker-compose.yml's mongo-test service (offset port so it never
# collides with a developer's own local Mongo on 27017).
MONGODB_TEST_URI=mongodb://localhost:27018/odysseus_test
CRAWLER_USER_AGENT=OdysseusAudit/0.1 (+https://odysseusaudit.com/bot)
MAX_PAGES=20
MAX_CRAWL_DEPTH=5
CRAWL_DELAY_MS=1000
PAGE_TIMEOUT_MS=30000
LIGHTHOUSE_TIMEOUT_MS=60000
# Blank = <workspace root>/artifacts
ODYSSEUS_ARTIFACTS_ROOT=

# Milestone 8.6. Chrome UX Report (CrUX) API key - generate one at
# https://goo.gle/crux-api-key. Blank = the CrUX field-data check is
# skipped entirely for every audit, not attempted and failed.
CRUX_API_KEY=

# Read-only Atlas user, used only by the mongodb-readonly MCP server for
# ad hoc inspection during development, never by the CLI or app code.
MDB_MCP_CONNECTION_STRING=

# Milestone 9c plan 009. The private bucket outreach previews are published to,
# and the base URL the link in an email points at. The three credentials have no
# default and throw when unset, so a publish command cannot look configured,
# sign with an empty key, and fail at the provider with a message about
# credentials rather than about this machine's .env.
#
# Set the same bucket, endpoint, region and credentials on the site deployment
# without the ODYSSEUS_ prefix (PREVIEW_BUCKET_NAME and so on): the public site
# reads its own environment and imports nothing from this workspace.
ODYSSEUS_PREVIEW_BUCKET_NAME=
ODYSSEUS_PREVIEW_BUCKET_ENDPOINT=https://s3.fr-par.scw.cloud
ODYSSEUS_PREVIEW_BUCKET_REGION=fr-par
ODYSSEUS_PREVIEW_BUCKET_ACCESS_KEY_ID=
ODYSSEUS_PREVIEW_BUCKET_SECRET_KEY=
# www, because the apex redirects and a redirect would carry a live token
# through a second host's request log.
ODYSSEUS_PREVIEW_PUBLIC_BASE_URL=https://www.odysseusaudit.com
