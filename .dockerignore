# Keeps the build context lean and secrets out of the image. Everything the
# build needs stays in: pnpm-workspace.yaml, .pnpmfile.cjs, all package.json
# manifests (pnpm install --frozen-lockfile needs every workspace importer,
# including fixtures/spa-demo and packages/site), the full source trees and
# the fixtures. The runtime stage then copies only what runs (issue #528):
# production dependencies, each package's dist, packages/report/src/styles
# and src/fonts (read at render time), scripts/ and one test-audit fixture.

# Secrets: never enter the image, not even in a builder layer.
.env
.env.*
!.env.example
!.env.smoke.example

# Version control and agent/CI metadata.
.git
.github
.agents
.claude
.codex
.zcode
.mcp.json
.playwright-mcp
.vscode
.idea

# Dependencies: installed inside the image, never copied from the host.
node_modules
**/node_modules

# Operator-local output and multi-gigabyte inputs; the container keeps its
# own artifacts in a volume (ODYSSEUS_ARTIFACTS_ROOT=/data/artifacts).
artifacts
data
reports
coverage
.vitest
*.tsbuildinfo
*.log

# Docs and plans: nothing runtime or build needs them.
docs
plans
*.md
!README.md

# packages/site is deployed on Vercel, not in this image. Its package.json
# must stay: the workspace importer list and the lockfile include it.
packages/site/*
!packages/site/package.json

.restic.env
.restic-password
