{
  "name": "@odysseus/scanner",
  "private": true,
  "version": "0.1.0",
  "description": "Playwright/Chromium browser lifecycle and the render-diff scanner.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -b && mkdir -p dist/config && cp src/config/*.json dist/config/",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@odysseus/core": "workspace:*",
    "crux-api": "^4.1.0",
    "html-validate": "^11.9.0",
    "lighthouse": "^13.4.1",
    "playwright": "^1.62.1",
    "structured-data-testing-tool": "^4.5.0"
  }
}
