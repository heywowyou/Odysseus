{
  "name": "@odysseus/interface",
  "private": true,
  "version": "0.1.0",
  "description": "Runs the job queue and a small private HTTP server that serves the single-user dashboard. The only package that binds a network port.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:dashboard": "vite",
    "build": "tsc -b && tsc -p tsconfig.public.json && mkdir -p dist/public/styles dist/public/fonts && cp src/public/*.html src/public/*.css dist/public/ && cp ../report/src/styles/nocturne.css dist/public/styles/nocturne.css && cp ../report/src/fonts/*.woff2 dist/public/fonts/ && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.public.json --noEmit && tsc -p tsconfig.dashboard.json --noEmit"
  },
  "dependencies": {
    "@odysseus/core": "workspace:*",
    "@odysseus/llm": "workspace:*",
    "@odysseus/report": "workspace:*",
    "@odysseus/scanner": "workspace:*",
    "@odysseus/store": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "csv-parse": "^5.6.0",
    "lucide-react": "^1.37.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  }
}
