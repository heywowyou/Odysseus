{
  "name": "@odysseus/interface",
  "private": true,
  "version": "0.1.0",
  "description": "Runs the job queue and a small private HTTP server that serves the single-user dashboard. The only package that binds a network port.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:dashboard": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dashboard.json --noEmit"
  },
  "dependencies": {
    "@odysseus/core": "workspace:*",
    "@odysseus/llm": "workspace:*",
    "@odysseus/report": "workspace:*",
    "@odysseus/scanner": "workspace:*",
    "@odysseus/store": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/node": "^10.74.0",
    "aws4fetch": "^1.0.20",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "lucide-react": "^1.37.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^4.7.0",
    "mongoose": "^9.9.1",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3",
    "vitest-axe": "^0.1.0"
  }
}
