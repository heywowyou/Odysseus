{
  "name": "@odysseus/report",
  "private": true,
  "version": "0.1.0",
  "description": "Owns the report template and turns a stored analysis plus findings into a PDF.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -b",
    "build:css": "tailwindcss -i ./src/template/tailwind-input.css -o ./src/template/report.css --minify",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@odysseus/core": "workspace:*",
    "@odysseus/scanner": "workspace:*",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "tailwindcss": "^4.3.3",
    "@tailwindcss/cli": "^4.3.3"
  }
}
