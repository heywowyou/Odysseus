{
  "name": "@odysseus/report",
  "private": true,
  "version": "0.1.0",
  "description": "Owns the report template and turns a stored analysis plus findings into a PDF.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@odysseus/core": "workspace:*",
    "@odysseus/llm": "workspace:*",
    "@odysseus/scanner": "workspace:*",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1"
  }
}
