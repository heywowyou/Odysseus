{
  "name": "@odysseus/report",
  "private": true,
  "version": "0.1.0",
  "description": "Owns the report template and turns a stored analysis plus findings into a PDF.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@odysseus/core": "workspace:*",
    "@odysseus/llm": "workspace:*",
    "@odysseus/scanner": "workspace:*",
    "pagedjs": "^0.4.3",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "pdf-parse": "^2.4.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0"
  }
}
