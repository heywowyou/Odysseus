#!/usr/bin/env bash
# Runs the fast static part of the release gate (docs links, formatting,
# lint, typecheck, dependency-cruiser architecture rules, fallow dead-code
# audit) before a push leaves this machine. Skips the test suites deliberately:
# they need Docker Mongo and Playwright Chromium, which not every push
# should have to pay for; `pnpm run gate` runs them before every deploy.
#
# Enabled once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

echo "pre-push: running pnpm run check (docs, format, lint, typecheck, architecture, dead code)..."
if ! pnpm run check; then
  echo
  echo "pre-push: pnpm run check failed. Fix the issue above, or skip this" \
    "hook once with 'git push --no-verify' if you are certain." >&2
  exit 1
fi
