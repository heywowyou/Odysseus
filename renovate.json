{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "timezone": "Europe/Paris",
  "schedule": ["before 6am every weekday"],
  "prConcurrentLimit": 4,
  "prHourlyLimit": 2,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "React/Next: framework surface, kept in one reviewed group.",
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-router",
        "next",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react and next"
    },
    {
      "description": "TypeScript/ESLint: kept in one reviewed group.",
      "matchPackageNames": [
        "typescript",
        "typescript-eslint",
        "eslint",
        "@eslint/js",
        "eslint-config-prettier",
        "eslint-plugin-react-hooks",
        "globals"
      ],
      "groupName": "typescript and eslint"
    },
    {
      "description": "Playwright/browser tooling: kept in one reviewed group so the pinned Chromium build and the MCP server move together.",
      "matchPackageNames": ["playwright", "@playwright/test", "@playwright/mcp"],
      "groupName": "playwright and browser tooling"
    },
    {
      "description": "Accessibility tooling: kept in one reviewed group.",
      "matchPackageNames": ["@axe-core/playwright", "vitest-axe", "axe-core"],
      "groupName": "accessibility tooling"
    },
    {
      "description": "Issue #252: majors on providers/engines with real behavior or cost risk stay manual - never automerged, never grouped away from a dedicated review.",
      "matchPackageNames": [
        "openai",
        "lighthouse",
        "mongoose",
        "next",
        "playwright",
        "@playwright/test",
        "@playwright/mcp",
        "pnpm"
      ],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["renovate/manual-major-review"]
    },
    {
      "description": "Issue #252: automerge only dev-only patch updates, and only after every required CI check passes.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Everything else (runtime deps, and every minor/major not covered above) stays a reviewed PR by default.",
      "matchUpdateTypes": ["minor", "major"],
      "matchDepTypes": ["dependencies"],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "description": "Issue #252: .codex/config.toml pins the Playwright MCP server's own npm version instead of floating on @latest (docs/agents/coding-conventions.md, 'Dependency maintenance'). Renovate reads/writes that pin the same way it would a package.json dependency.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.codex/config\\.toml$/"],
      "matchStrings": ["\"@playwright/mcp@(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "@playwright/mcp",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Context7 MCP is pinned in .mcp.json so agent documentation behavior changes only through a reviewed diff.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.mcp\\.json$/"],
      "matchStrings": ["\"@upstash/context7-mcp@(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "@upstash/context7-mcp",
      "datasourceTemplate": "npm"
    },
    {
      "description": "IBM Equal Access CLI is pinned in the CI wrapper; Renovate keeps the secondary accessibility engine current through reviewed diffs.",
      "customType": "regex",
      "managerFilePatterns": ["/^deploy\\/equal-access-ci\\.sh$/"],
      "matchStrings": ["accessibility-checker@(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "accessibility-checker",
      "datasourceTemplate": "npm"
    },
    {
      "description": "The local Renovate runner pins its own image; Renovate reports its next version like any other dependency.",
      "customType": "regex",
      "managerFilePatterns": ["/^scripts\\/renovate-local\\.mjs$/"],
      "matchStrings": ["ghcr\\.io/renovatebot/renovate:(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "ghcr.io/renovatebot/renovate",
      "datasourceTemplate": "docker"
    },
    {
      "description": "The restic Docker image is pinned in deployment scripts; Renovate keeps backup tooling updates reviewable.",
      "customType": "regex",
      "managerFilePatterns": ["/^deploy\\/restic-(?:backup|check|restore-drill|maintain)\\.sh$/"],
      "matchStrings": ["restic/restic:(?<currentValue>[0-9.]+)"],
      "depNameTemplate": "restic/restic",
      "datasourceTemplate": "docker"
    }
  ]
}
