{
  "name": "odysseus",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic web audit engine: technical/SPA-SEO and accessibility audits, prioritized by an LLM layer that never detects.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "check": "pnpm run docs:check && pnpm run plans:check && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run architecture:check && pnpm run audit:code",
    "docs:check": "node scripts/check-agent-docs.mjs",
    "plans:check": "node scripts/check-plan-quality.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "architecture:check": "depcruise --config .dependency-cruiser.cjs packages/core/src packages/scanner/src packages/llm/src packages/store/src packages/report/src packages/interface/src packages/cli/src packages/site/app packages/site/lib",
    "audit:code": "fallow dead-code",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project \"e2e*\"",
    "test:all": "vitest run",
    "test:deploy": "bash deploy/release.test.sh && bash deploy/render-server-compose.test.sh && bash deploy/compose.test.sh && bash deploy/odysseus-deploy.test.sh && bash deploy/restic-scripts.test.sh && bash -n deploy/equal-access-ci.sh",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc -b --pretty && tsc -p packages/interface/tsconfig.dashboard.json --noEmit",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test:store:up": "docker compose up -d mongo-test",
    "test:store:down": "docker compose down",
    "serve": "tsx packages/cli/src/index.ts serve",
    "serve:full": "pnpm --filter @odysseus/cli... run build && pnpm run serve",
    "report:finalize-render": "tsx packages/cli/src/index.ts report:finalize",
    "report:workbench": "tsx scripts/report-workbench.ts",
    "report:workbench:options": "tsx scripts/report-workbench-options.ts",
    "fixtures:rules": "node scripts/build-observed-rule-inventory.mjs",
    "fixtures:refresh": "node scripts/refresh-fixtures.mjs",
    "measure:audit-data-quality": "node scripts/measure-audit-data-quality.mjs",
    "fixtures:pushback-corpus": "tsx scripts/build-pushback-corpus.ts",
    "deps:check": "node scripts/renovate-local.mjs",
    "deps:apply": "node scripts/renovate-apply.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.4",
    "dependency-cruiser": "18.3.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fallow": "3.24.1",
    "fast-check": "4.10.2",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "vitest-axe": "^0.1.0"
  }
}
