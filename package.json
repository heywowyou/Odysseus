{
  "name": "odysseus",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic web audit engine: technical/SPA-SEO and accessibility audits, prioritized by an LLM layer that never detects.",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "check": "pnpm run docs:check && pnpm run format:check && pnpm run lint && pnpm run typecheck",
    "docs:check": "node scripts/check-agent-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:all": "vitest run",
    "test:deploy": "bash deploy/release.test.sh && bash deploy/render-server-compose.test.sh && bash deploy/odysseus-deploy.test.sh",
    "test:watch": "vitest --project unit",
    "typecheck": "tsc -b --pretty && tsc -p packages/interface/tsconfig.dashboard.json --noEmit",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test:store:up": "docker compose up -d mongo-test",
    "test:store:down": "docker compose down",
    "serve": "tsx packages/cli/src/index.ts serve",
    "serve:full": "pnpm --filter @odysseus/cli... run build && pnpm run serve",
    "fixtures:rules": "node scripts/build-observed-rule-inventory.mjs",
    "fixtures:refresh": "node scripts/refresh-fixtures.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^22.10.5",
    "axe-core": "^4.13.0",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.11.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "prettier": "3.9.6",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "8.68.0",
    "vitest": "^3.0.4",
    "vitest-axe": "^0.1.0"
  }
}
