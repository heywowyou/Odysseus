{
  "name": "odysseus",
  "private": true,
  "version": "0.1.0",
  "description": "Deterministic web audit engine: technical/SPA-SEO and accessibility audits, prioritized by an LLM layer that never detects.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@11.22.0+sha512.1ff870c4c6133dfd88fb2afc46dd13d47f09c9794b438c6fdb47ca98caf3bc16381ee0be93a091b8e3824cf01f889f46d7d9e20910fb0be1ab0fb5baa80dd621",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test:store:up": "docker compose up -d mongo-test",
    "test:store:down": "docker compose down",
    "serve": "tsx packages/cli/src/index.ts serve",
    "serve:full": "pnpm --filter @odysseus/cli... run build && pnpm run serve",
    "fixtures:refresh": "node scripts/refresh-fixtures.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.0.4"
  }
}
